        <item name="gemPill">@drawable/bg_pill_light</item>
        <item name="gemInput">@drawable/bg_input_light</item>
        <item name="gemCard">@drawable/bg_card_light</item>
        <item name="gemStatus">@drawable/bg_status_light</item>
        <item name="gemCircleDark">@drawable/bg_circle_neutral_light</item>
        <item name="gemCircleToggle">@drawable/bg_circle_toggle_light</item>
        <item name="gemBubbleSystem">@drawable/bubble_system_light</item>
        <item name="android:statusBarColor">@color/light_bg</item>
        <item name="android:navigationBarColor">@color/light_bg</item>

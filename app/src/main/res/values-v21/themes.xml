<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GemLegacy.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="gemBg">@color/dark_bg</item>
        <item name="gemSurface">@color/dark_surface</item>
        <item name="gemDivider">@color/dark_divider</item>
        <item name="gemText">@color/dark_text</item>
        <item name="gemTextSecondary">@color/dark_text_secondary</item>
        <item name="gemHint">@color/dark_hint</item>
        <item name="gemAccent">@color/dark_accent</item>
        <item name="gemPill">@drawable/bg_pill_dark</item>
        <item name="gemInput">@drawable/bg_input_dark</item>
        <item name="gemCard">@drawable/bg_card_dark</item>
        <item name="gemStatus">@drawable/bg_status_dark</item>
        <item name="gemCircleDark">@drawable/bg_circle_neutral_dark</item>
        <item name="gemCircleToggle">@drawable/bg_circle_toggle_dark</item>

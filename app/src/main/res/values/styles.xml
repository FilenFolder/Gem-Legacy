<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PillButton">
        <item name="android:background">?attr/gemPill</item>
        <item name="android:textColor">?attr/gemText</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
    </style>

    <style name="PillButton.Blue">
        <item name="android:background">@drawable/bg_pill_blue</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="RoundIconButton">
        <item name="android:background">?attr/gemCircleDark</item>
        <item name="android:padding">9dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textColor">#FF64B5F6</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>
</resources>
